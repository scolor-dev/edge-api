{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "edge-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-09",
	"r2_buckets": [
		{
			"binding": "SCD_BUCKET",
			"bucket_name": "scd-bucket"
		},
		{
			"bucket_name": "scd-bucket",
			"binding": "scd_bucket"
		}
	],
	"d1_databases": [
		{
			"binding": "SCD_DB",
			"database_name": "scd-db",
			"database_id": "placeholder"
		},
		{
			"binding": "scd_db",
			"database_name": "scd-db",
			"database_id": "6d9c7842-d119-47a3-af05-6d85f9afa4a4"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
}